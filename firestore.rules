rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isVendor() {
      return isAuthenticated() && getUserData().role == 'vendor';
    }

    function isVendorOwner(vendorId) {
      return isAuthenticated() && getUserData().vendorId == vendorId;
    }

    // Users collection
    match /users/{userId} {
      // User can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // User can create their own profile document
      allow create: if request.auth != null && request.auth.uid == userId;

      // User can update their own profile (but not role/vendorId)
      allow update: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'vendorId']);

      // No delete allowed
      allow delete: if false;
    }

    // Vendors collection
    match /vendors/{vendorId} {
      // Public profiles - anyone can read
      allow read: if true;

      // Authenticated user can create vendor profile with their own userId
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Vendor owner can update their profile
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // No delete allowed (soft delete only)
      allow delete: if false;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if resource.data.status == 'active' ||
        (isAuthenticated() && isVendorOwner(resource.data.vendorId));
      allow create: if isVendor();
      allow update: if isVendorOwner(resource.data.vendorId);
      allow delete: if false; // Soft delete only

      // Slots subcollection
      match /slots/{slotId} {
        allow read: if true;
        allow write: if isVendorOwner(get(/databases/$(database)/documents/events/$(eventId)).data.vendorId);
      }
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) ||
        isVendorOwner(resource.data.vendorId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isVendorOwner(resource.data.vendorId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Tickets collection
    match /tickets/{ticketId} {
      // Ticket owner or vendor can read
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );

      // Created by Cloud Functions only (admin SDK bypasses rules)
      allow create: if false;

      // Vendor can update ticket status (for check-in)
      allow update: if request.auth != null &&
        resource.data.vendorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'usedAt', 'checkedIn', 'checkedInAt', 'updatedAt']);
    }

    // Payouts collection
    match /payouts/{payoutId} {
      allow read: if isVendorOwner(resource.data.vendorId);
      allow write: if false; // Managed by Cloud Functions
    }
  }
}
